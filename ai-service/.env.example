# Gemini API Key — lấy tại https://aistudio.google.com → Get API Key
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
# Scan/multi-column CVs: Groq vision (up to 3 pages), then Gemini PDF (all pages).
# API models only; no local model download. At most 20 seconds per provider.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_CV_MODEL=gemini-3.8-flash
# Writing/review and JD summaries use Groq first, Gemini as fallback.
GROQ_API_KEY=PASTE_YOUR_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# GitHub Personal Access Token (tùy chọn nhưng khuyến nghị để tăng rate limit từ 60 lên 5,000 req/h)
GITHUB_TOKEN=

# Set to ollama to process PDF (including scans) and assess CV/JD locally.
# The model must be pulled before starting ai-service.
# CV_PROCESSING_PROVIDER=ollama
# JD import (PDF text/scans, DOCX and pasted text) uses the same local model when enabled.
# JD_IMPORT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3-vl:2b-instruct-q4_K_M
